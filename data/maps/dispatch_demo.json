  "nodes": [
    {
      "id": "dsp_intro",
      "type": "dialogue",
      "speaker_id": "dsp_caller",
      "text": "Simulación fuera de campaña. Hay un aviso sanitario y otro de sensor urbano. El sensor podría ser de ensayo: puede comprobarlo antes de ocupar la patrulla. La información de las fichas indica qué tipo de unidad corresponde.",
      "options": [
        {
          "id": "dsp_report",
          "text": "Registrar los avisos de prueba.",
          "next": "dsp_hub",
          "effects": [
            {
              "op": "set",
              "target": "reported",
              "value": true
            }
          ]
        }
      ]
    },
    {
      "id": "dsp_hub",
      "type": "dialogue",
      "speaker_id": "dsp_caller",
      "text": "Puede consultar Mapa y confirmar asignaciones. Cada llegada, resultado y liberación se recibe por una acción explícita; leer y cambiar de pestaña no avanza la intervención.",
      "options": [
        {
          "id": "dsp_verify",
          "text": "Comprobar si el sensor urbano está en modo de ensayo.",
          "next": "dsp_hub",
          "visible_when": {
            "op": "once_not_applied",
            "value": "dsp_verify"
          },
          "effects": [
            {
              "op": "set",
              "target": "alarm_verified",
              "value": true
            }
          ]
        },
        {
          "id": "dsp_new_port",
          "text": "Registrar un nuevo aviso de acceso portuario.",
          "next": "dsp_hub",
          "visible_when": {
            "op": "all",
            "conditions": [
              {
                "op": "once_not_applied",
                "value": "dsp_new_port"
              },
              {
                "op": "any",
                "conditions": [
                  {
                    "op": "contains",
                    "target": "executed_actions",
                    "value": "dsp_verify"
                  },
                  {
                    "op": "contains",
                    "target": "executed_actions",
                    "value": "assign_patrol_01_to_dsp_alarm"
                  }
                ]
              }
            ]
          },
          "effects": [
            {
              "op": "set",
              "target": "port_reported",
              "value": true
            }
          ]
        },
        {
          "id": "dsp_followup",
          "text": "Consultar el resultado portuario confirmado.",
          "next": "dsp_hub",
          "visible_when": {
            "op": "equals",
            "target": "port_done",
            "value": true
          }
        },
        {
          "id": "dsp_finish",
          "text": "Cerrar la demostración con el parte portuario.",
          "next": "dsp_end",
          "visible_when": {
            "op": "contains",
            "target": "executed_actions",
            "value": "dsp_port_release"
          }
        },
        {
          "id": "dsp_close",
          "text": "Cerrar la demostración con el estado actual.",
          "next": "dsp_partial_end"
        }
      ]
    },
    {
      "id": "dsp_end",
      "type": "ending",
      "ending_id": "dsp_complete",
      "text": "Simulación cerrada. Las asignaciones y partes confirmados permanecen consultables."
    },
    {
      "id": "dsp_partial_end",
      "type": "ending",
      "ending_id": "dsp_partial",
      "text": "Simulación cerrada sin completar todas las intervenciones. Los recursos conservan su estado registrado; cerrar no los libera."
    }
  ]
