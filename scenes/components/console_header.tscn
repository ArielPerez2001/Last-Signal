[gd_scene format=3]

[node name="ConsoleHeader" type="PanelContainer"]
layout_mode = 2
theme_type_variation = &"TerminalPanel"

[node name="Content" type="VBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 12

[node name="TopRow" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="MenuButton" type="Button" parent="Content/TopRow"]
custom_minimum_size = Vector2(112, 88)
layout_mode = 2
text = "Menú"

[node name="Station" type="Label" parent="Content/TopRow"]
layout_mode = 2
size_flags_horizontal = 3
text = "Central de\nEmergencias"
horizontal_alignment = 2
autowrap_mode = 3

[node name="LocationRow" type="HBoxContainer" parent="Content"]
layout_mode = 2

[node name="Location" type="Label" parent="Content/LocationRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_type_variation = &"KickerLabel"
text = "Puerto Umbral · 1998"
autowrap_mode = 3

[node name="Time" type="Label" parent="Content/LocationRow"]
layout_mode = 2
text = "02:17 AM"

[node name="Status" type="Label" parent="Content"]
layout_mode = 2
theme_type_variation = &"SignalLabel"
text = "COMUNICACIONES · LÍNEA EN ESPERA"
autowrap_mode = 3
