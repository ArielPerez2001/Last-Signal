extends "res://tests/save/save_test_support.gd"

const Calls = preload("res://scripts/systems/call_controller.gd")
const Director = preload("res://scripts/ui/case_flow_director.gd")
const Deductions = preload("res://scripts/systems/deduction_manager.gd")
const Dispatch = preload("res://scripts/systems/dispatch_manager.gd")


func _run() -> void:
	_check(FileAccess.get_sha256(Calls.OFFICIAL_PATH) == "052d1b73bbc5b8d1beb29da8a3a084f823360c2a90cc48b403239e6e19238064", "canonical content and fingerprint preserved")
	var calls = Calls.new(_new_directory("redesign"))
	_check(calls.prepare_call(Calls.OFFICIAL_PATH).ok, "incoming official call")
	calls.saves.set_autosave_enabled(false)
	var engine = calls.engine
	var director = Director.new(engine, calls.saves)
	_check(director.actions().size() == 1 and director.actions()[0].choice == "c001_n01_o01", "first action unambiguous")
	_check(not director.unlocked("archive") and not director.unlocked("dispatch") and not director.unlocked("audio"), "no tools before their need")
	_check(calls.answer_call().ok, "answer")
	for id: String in ["c001_n01_o01", "c001_n03_o01", "c001_n04_o01"]:
		_check(calls.select_choice(id, engine.get_state_snapshot().revision).ok, "first conversation " + id)
	var before: Dictionary = engine.get_state_snapshot()
	var notifications: Array = []
	engine.state_changed.connect(func(state: Dictionary) -> void: notifications.append(state))
	_check(not calls.select_choices(["c001_n05_o01", "nonexistent"], before.revision).ok, "bad sequence rejected")
	_check(engine.get_state_snapshot() == before and notifications.is_empty(), "sequence rollback includes history and events")
	_check(not calls.select_choices(director.sequence("c001_n05_o01"), before.revision - 1).ok, "stale shortcut rejected")
	_check(calls.select_choices(director.sequence("c001_n05_o01"), before.revision).ok, "direct record")
	_check(engine.get_current_node().id == "c001_n08" and notifications.size() == 1, "single stable publication at record")
	_check("c001_e02" in engine.get_state_snapshot().evidence and director.unlocked("archive"), "discovery registered automatically")
	_check(calls.saves.save_current_session().ok, "pre-11R shape checkpoint")
	var old: Dictionary = _document(calls.saves.get_paths().main)
	_check(old.size() == 8 and not old.has("presentation"), "old envelope retained without tutorial metadata")
	_check(calls.select_choices(director.sequence("c001_n08_o01"), engine.get_state_snapshot().revision).ok, "record goes straight to reasoning")
	var deductions = Deductions.new(engine)
	var view: Dictionary = deductions.get_reasoning("c001_q01")
	_check(view.code == "READY" and view.data.sources.size() == 2 and view.data.answers.size() == 2, "guided first deduction uses two known sources")
	before = engine.get_state_snapshot()
	_check(not deductions.reason("c001_q01", "prank", before.revision).ok, "incorrect conclusion explained")
	_check(engine.get_state_snapshot() == before, "wrong reasoning has no penalty or effects")
	_check(not deductions.reason("c001_q01", "contradiction", before.revision - 1).ok, "stale reasoning rejected")
	_check(deductions.reason("c001_q01", "contradiction", before.revision).ok, "logical service confirms conclusion")
	before = engine.get_state_snapshot()
	_check(deductions.reason("c001_q01", "contradiction", before.revision).code == "ALREADY_DISCOVERED", "repeated reasoning idempotent")
	_check(engine.get_state_snapshot() == before, "conclusion not duplicated")
	_check(not deductions.reason("c001_q02", "separate_route", before.revision).ok, "no unearned subsequent deduction")
	_check(director.unlocked("dispatch") and director.unlocked("audio"), "tools emerge from existing discoveries")
	for id: String in ["answer", "record", "deduction"]:
		_check(calls.saves.mark_tutorial_seen(id).ok, "tutorial completion " + id)
	_check(engine.get_state_snapshot() == before, "tutorials do not change story")
	_check(calls.saves.get_status().data.dirty and calls.saves.save_current_session().ok, "tutorial data shares existing checkpoint")
	var saved: Dictionary = _document(calls.saves.get_paths().main)
	_check(saved.size() == 9 and saved.presentation.version == 1, "explicit presentation extension")
	var restored = Calls.new(calls.saves.get_paths().main.get_base_dir())
	_check(restored.restore_call(Calls.OFFICIAL_PATH).ok, "new save restores")
	_check(restored.engine.get_state_snapshot() == before and restored.saves.get_tutorials_seen() == calls.saves.get_tutorials_seen(), "story and tutorial restoration exact")
	var restored_director = Director.new(restored.engine, restored.saves)
	_check(restored_director.tutorial("deduction").is_empty(), "completed tutorial not repeated")
	var legacy_directory: String = _new_directory("redesign_legacy")
	_write(legacy_directory.path_join("slot_01.json"), old)
	var legacy = Calls.new(legacy_directory)
	_check(legacy.restore_call(Calls.OFFICIAL_PATH).ok and legacy.engine.get_current_node().id == "c001_n08", "existing eight-field save accepted without reset")
	_check(legacy.saves.get_tutorials_seen().is_empty(), "old save has no invented tutorial flags")
	for bad: Variant in [{"version":2,"tutorials_seen":[]}, {"version":1,"tutorials_seen":["unknown"]}, {"version":1,"tutorials_seen":["answer","answer"]}, {"version":1,"tutorials_seen":"answer"}]:
		var folder: String = _new_directory("redesign_invalid")
		var document: Dictionary = saved.duplicate(true)
		document.presentation = bad
		_write(folder.path_join("slot_01.json"), document)
		var original_bytes: String = FileAccess.get_file_as_string(folder.path_join("slot_01.json"))
		var reader = Calls.new(folder)
		_check(not reader.restore_call(Calls.OFFICIAL_PATH).ok, "bad tutorial metadata rejected")
		_check(FileAccess.get_file_as_string(folder.path_join("slot_01.json")) == original_bytes, "incompatible original preserved byte for byte")
		reader.dispose()
	before = engine.get_state_snapshot()
	for count: int in range(3):
		director.goal()
		director.actions()
		director.tutorial("deduction")
	_check(before == engine.get_state_snapshot(), "all orientation queries pure")
	_check(engine.validate_state_snapshot(before).ok, "normal replay accepts grouped journal")
	_check(calls.select_choice("c001_n17_o01", before.revision).ok, "return to conversation")
	var dispatch = Dispatch.new(engine)
	dispatch.contextual_reports = true
	before = engine.get_state_snapshot()
	_check(not dispatch.dispatch_unit("invalid", "c001_i02").ok and engine.get_state_snapshot() == before, "invalid dispatch is pure")
	_check(dispatch.dispatch_unit("c001_r1", "c001_i02", before.revision).ok, "contextual inspection uses normal dispatch")
	_check(dispatch.process_event("c001_u02", "c001_r1", "c001_i02").ok, "report available without map route")
	_check(deductions.get_reasoning("c001_q02").code == "INCOMPLETE", "tutorial never automatically earns favorable interpretation")
	for id: String in ["c001_n20_o01", "c001_n10_o02", "c001_n12_o01"]:
		_check(engine.select_choice(id, engine.get_state_snapshot().revision), "obtain danger testimony " + id)
	before = engine.get_state_snapshot()
	_check(deductions.get_reasoning("c001_q02").data.sources.size() == 3, "later reasoning presents its three discovered sources")
	_check(not deductions.reason("c001_q02", "present", before.revision).ok and engine.get_state_snapshot() == before, "present exterior does not invalidate communicated danger")
	_check(deductions.reason("c001_q02", "separate_route", before.revision).ok, "later reasoning uses existing Q02")
	for id: String in ["c001_n10_o09", "c001_n21_o01", "c001_n22_o01", "c001_n23_o01", "c001_n24_o01", "c001_n10_o05", "c001_n15_o01", "c001_n10_o04", "c001_n14_o01"]:
		_check(engine.select_choice(id, engine.get_state_snapshot().revision), "known optional sources " + id)
	for entry: Array in [["c001_q03", "cause", "link"], ["c001_q04", "fate", "identity"]]:
		before = engine.get_state_snapshot()
		_check(deductions.get_reasoning(entry[0]).code == "READY", "optional reasoning has its sources " + entry[0])
		_check(not deductions.reason(entry[0], entry[1], before.revision).ok and engine.get_state_snapshot() == before, "optional answer cannot resolve open mystery " + entry[0])
		_check(deductions.reason(entry[0], entry[2], before.revision).ok, "optional conclusion confirmed by existing service " + entry[0])
	_check(engine.get_state_snapshot().variables.resultado == "pendiente", "all conclusions leave actual ending decision to player")
	calls.dispose()
	restored.dispose()
	legacy.dispose()
	_finish("case_redesign")
